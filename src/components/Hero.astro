---
import { companyInfo } from '../data/company';
import { Sparkles, ArrowRight } from 'lucide-astro';
---

<section id="hero" class="py-16 md:py-24 bg-gradient-to-b from-blue-50/70 via-white to-white">
    <div class="max-w-6xl mx-auto px-4 text-center">
        <!-- Badge bernuansa Biru -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100/80 text-blue-800 text-xs font-bold mb-6">
            <Sparkles class="w-4 h-4 text-blue-700" />
            <span>Custom Merchandise Premium</span>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="text-3xl md:text-5xl font-extrabold text-blue-950 tracking-tight leading-tight mb-4 max-w-3xl mx-auto">
            {companyInfo.tagline}
        </h1>
        <p class="text-slate-600 text-base md:text-lg max-w-2xl mx-auto mb-8">
            {companyInfo.description}
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
            <a 
                href="#products" 
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-blue-800 hover:bg-blue-900 text-white font-bold px-6 py-3 rounded-xl transition shadow-lg shadow-blue-900/15"
            >
                <span>Lihat Katalog</span>
                <ArrowRight class="w-4 h-4" />
            </a>
            <a 
                href="#how-to-order" 
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white border border-blue-200 hover:bg-blue-50 text-blue-900 font-bold px-6 py-3 rounded-xl transition"
            >
                <span>Cara Pemesanan</span>
            </a>
        </div>
    </div>
</section>