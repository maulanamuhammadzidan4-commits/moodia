---
import { companyInfo } from '../data/company';
---

<footer class="bg-blue-950 text-blue-100">
    <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Brand -->
            <div>
                <div class="flex items-center gap-2 mb-3">
                    <img src="/logo.svg" alt="MOODIA Logo" class="h-8 w-auto object-contain brightness-200" />
                    <span class="font-extrabold text-xl tracking-tight text-white">{companyInfo.name}</span>
                </div>
                <p class="text-sm text-blue-300 leading-relaxed max-w-xs">
                    {companyInfo.description}
                </p>
            </div>

            <!-- Navigasi Cepat -->
            <div>
                <h4 class="font-bold text-white mb-3 text-sm uppercase tracking-wider">Navigasi</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="#hero" class="hover:text-white transition">Beranda</a></li>
                    <li><a href="#products" class="hover:text-white transition">Katalog Produk</a></li>
                    <li><a href="#how-to-order" class="hover:text-white transition">Cara Pesan</a></li>
                    <li><a href="#developer" class="hover:text-white transition">Developer</a></li>
                </ul>
            </div>

            <!-- Kontak -->
            <div>
                <h4 class="font-bold text-white mb-3 text-sm uppercase tracking-wider">Hubungi Kami</h4>
                <ul class="space-y-2 text-sm">
                    <li>
                        <a 
                            href={`https://wa.me/${companyInfo.whatsappNumber}`} 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="hover:text-white transition"
                        >
                            WhatsApp
                        </a>
                    </li>
                    <li>
                        <a 
                            href={`https://instagram.com/${companyInfo.instagram.replace('@', '')}`} 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="hover:text-white transition"
                        >
                            Instagram {companyInfo.instagram}
                        </a>
                    </li>
                    <li class="text-blue-300">{companyInfo.location}</li>
                </ul>
            </div>
        </div>

        <!-- Copyright -->
        <div class="border-t border-blue-900 mt-10 pt-6 text-center text-xs text-blue-400">
            &copy; {new Date().getFullYear()} {companyInfo.name}. Semua hak dilindungi.
        </div>
    </div>
</footer>
