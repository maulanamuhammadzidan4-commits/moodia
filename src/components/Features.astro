---
import { ShieldCheck, Palette, Zap } from 'lucide-astro';

const features = [
    {
        icon: Palette,
        title: "Desain Bebas & Kustom",
        description: "Kirim desain buatanmu sendiri atau kami bantu buatkan sesuai keinginanmu."
    },
    {
        icon: ShieldCheck,
        title: "Kualitas Premium",
        description: "Bahan mug, tumbler, kaos, dan akrilik standar terbaik yang tahan lama."
    },
    {
        icon: Zap,
        title: "Pengerjaan Cepat",
        description: "Proses produksi presisi dan siap diantarkan tepat waktu untuk kebutuhanmu."
    }
];
---

<section id="features" class="py-16 bg-slate-50 border-y border-slate-100">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-2xl md:text-3xl font-extrabold text-blue-950 tracking-tight">
                Kenapa Harus Memilih MOODIA?
            </h2>
            <p class="text-slate-600 text-sm mt-2">
                Kami memberikan pelayanan dan produk kustom terbaik untuk kelompok dan personal.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:flex gap-6">
            {features.map((item) => (
                <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:border-blue-200 transition">
                    <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center mb-4">
                        <item.icon class="w-5 h-5" />
                    </div>
                    <h3 class="font-bold text-slate-900 text-base mb-1">{item.title}</h3>
                    <p class="text-slate-600 text-xs leading-relaxed">{item.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>