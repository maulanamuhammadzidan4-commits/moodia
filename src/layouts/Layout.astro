---
import '../styles/global.css';
import AntiSpamToast from '../components/AntiSpamToast.astro';
import ScrollToTop from '../components/ScrollToTop.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Katalog Custom Merchandise MOODIA - Mug, Keychain, Tumbler, dan Kaos." />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/logo-2.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="bg-white text-slate-800 antialiased font-sans">
        <slot />
        <ScrollToTop />
        <AntiSpamToast />
    </body>
</html>